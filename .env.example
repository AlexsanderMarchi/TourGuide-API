# Valores abaixo são exemplos: troque pelos reais antes de usar.

# variaveis do MySQL do container
DB_NAME=nome_banco
DB_URL=url_banco
DB_USERNAME=usuario_do_banco
DB_PASSWORD=senha_do_banco

# Secret usado para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET=troque-por-um-secret-grande-e-aleatorio-com-32-caracteres-ou-mais

# OAuth App do GitHub (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=seu_client_id_do_github
GITHUB_CLIENT_SECRET=seu_client_secret_do_github

# Email que envia a recuperação de senha (no Gmail, use uma "senha de app", não a senha da conta)
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app
